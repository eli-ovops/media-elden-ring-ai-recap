[{"start": 0.0, "end": 2.267, "text": "玩过艾尔登法环的玩家"}, {"start": 2.267, "end": 5.207, "text": "应该都还记得有一个东西叫大树守卫"}, {"start": 5.207, "end": 8.207, "text": "真的是每个新手的噩梦啊"}, {"start": 8.207, "end": 12.267, "text": "然后前两天我让我的Codex"}, {"start": 12.267, "end": 15.807, "text": "帮我复刻了一版大树守卫"}, {"start": 15.807, "end": 18.667, "text": "我用的模型是Astra"}, {"start": 18.667, "end": 22.407, "text": "还有Sol 6.1的Ultra"}, {"start": 22.407, "end": 24.367, "text": "然后折腾了整整三天"}, {"start": 24.367, "end": 28.047, "text": "花了差不多70个亿左右的Token"}, {"start": 28.467, "end": 31.113, "text": "不过我为什么忽然想要做游戏呢"}, {"start": 31.113, "end": 32.553, "text": "其实是有原因的"}, {"start": 32.553, "end": 36.033, "text": "因为前几天我刷到有大神"}, {"start": 36.033, "end": 38.873, "text": "用Opus 5.5做了一个小王子啊"}, {"start": 39.393, "end": 42.633, "text": "他的那个小王子有云海上的草地"}, {"start": 42.633, "end": 43.873, "text": "还有宫殿"}, {"start": 43.873, "end": 45.313, "text": "还有玫瑰花园"}, {"start": 45.313, "end": 46.993, "text": "我看完了我就想过"}, {"start": 47.993, "end": 49.433, "text": "为什么我不能试一下呢"}, {"start": 49.433, "end": 51.273, "text": "然后我就开始尝试"}, {"start": 52.073, "end": 55.233, "text": "这个作者他总共花了16天"}, {"start": 55.233, "end": 56.393, "text": "然后结合了"}, {"start": 56.393, "end": 58.393, "text": "Claude然后Astra"}, {"start": 58.393, "end": 60.393, "text": "然后用Astra再去"}, {"start": 61.513, "end": 63.033, "text": "运用那些Blender"}, {"start": 63.673, "end": 66.393, "text": "最终完成了优化和修Bug"}, {"start": 66.913, "end": 68.753, "text": "然后才能呈现出来我们"}, {"start": 69.153, "end": 70.913, "text": "最终看到的小王子"}, {"start": 71.06700000000001, "end": 73.867, "text": "我做的这版大树守卫"}, {"start": 73.867, "end": 76.117, "text": "和我真的想要的"}, {"start": 76.117, "end": 78.67699999999999, "text": "其实差距还是比较远的"}, {"start": 78.67699999999999, "end": 82.277, "text": "但是我真的是烧不动Token了"}, {"start": 82.277, "end": 85.017, "text": "我把源码还有模型的那些资源"}, {"start": 85.017, "end": 87.477, "text": "都已经放到GitHub了"}, {"start": 87.477, "end": 91.117, "text": "然后如果说有兴趣的大神的话"}, {"start": 91.117, "end": 94.217, "text": "可以去接着我的模型继续"}, {"start": 94.217, "end": 94.997, "text": "接下去做"}, {"start": 94.997, "end": 97.917, "text": "我是真的实在是烧不动了"}, {"start": 97.917, "end": 101.017, "text": "如果说你们有兴趣的话"}, {"start": 101.017, "end": 104.017, "text": "可以问我要GitHub的链接"}]